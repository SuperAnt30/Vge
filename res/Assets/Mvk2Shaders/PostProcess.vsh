#version 330 core

// Полноэкранный треугольник без вершинного буфера.
// gl_VertexID 0, 1, 2 -> (0,0), (2,0), (0,2): треугольник накрывает весь экран,
// лишнее отсекается. Один треугольник чуть быстрее двух (нет шва по диагонали)

out vec2 a_uv;

void main()
{
    vec2 p = vec2((gl_VertexID << 1) & 2, gl_VertexID & 2);
    a_uv = p;
    gl_Position = vec4(p * 2.0 - 1.0, 0.0, 1.0);
}
